{
  ///////////////////////
  // Workbench
  ///////////////////////
  "editor.cursorBlinking": "expand",
  "http.proxyStrictSSL": false,
  "workbench.startupEditor": "newUntitledFile",
  "workbench.editor.showIcons": true,
  "workbench.editor.highlightModifiedTabs": true,
  "editor.suggestSelection": "first",
  "explorer.compactFolders": false,
  "workbench.editor.enablePreview": false,
  // "workbench.editor.wrapTabs": true,
  // "workbench.activityBar.location": "hidden",
  "workbench.editor.centeredLayoutAutoResize": true,
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.iconTheme": "catppuccin-macchiato",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook",
  },
  "workbench.settings.editor": "json",
  ///////////////////////
  //        Git
  ///////////////////////
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "scm.defaultViewMode": "tree",
  "files.exclude": {
    "**/.git": false,
  },
  ///////////////////////
  // file and language specific
  ///////////////////////
  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
    "editor.tabSize": 2,
    "files.trimTrailingWhitespace": false,
    "editor.formatOnSave": false,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.quickSuggestions": {
      "strings": true,
    },
    "editor.tabSize": 2,
    "editor.fontLigatures": false,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "json.schemas": [
    {
      "fileMatch": ["*-reginfo-*", "*-dmv-*", "*-customer-*", "*-trade-*"],
      "url": "./admin/schema/quercus-2020-07-13.json",
    },
  ],
  "[arm-template]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "msazurermtools.azurerm-vscode-tools",
  },
  "[js]": {
    "editor.formatOnSave": false,
  },
  "[javascript]": {
    "editor.formatOnSave": false,
  },
  "[go]": {
    "editor.quickSuggestions": {
      "strings": true,
    },
    "editor.foldingStrategy": "indentation",
    "editor.tabSize": 4,
  },
  "go.toolsManagement.autoUpdate": true,
  "go.formatTool": "gofmt",
  "go.useLanguageServer": true,
  "[yaml]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
    "editor.tabSize": 2,
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "yaml.schemas": {
    "/Users/jasoncobb/Work/azure-platform-governance-as-code/c7n-yaml-schema.json": [
      // "*yml"
      "*yaml",
    ],
  },
  "[helm]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
    "editor.tabSize": 2,
  },
  "[csharp]": {
    "editor.formatOnSave": true,
  },
  "csharp.suppressBuildAssetsNotification": true,
  "[cshtml]": {
    "editor.formatOnSave": false,
  },
  "[aspnetcorerazor]": {
    "editor.formatOnSave": false,
  },
  "[kotlin]": {
    "editor.formatOnSave": false,
  },
  "[c]": {
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.insertMode": "replace",
    "editor.semanticHighlighting.enabled": true,
    "editor.formatOnSave": false,
  },
  "[python]": {
    "editor.formatOnType": true,
  },
  "autopep8.args": ["--max-line-length", "120"],
  "python.languageServer": "Default",
  "[powershell]": {
    "editor.formatOnSave": true,
  },
  "powershell.powerShellDefaultVersion": "pwsh",
  "powershell.powerShellAdditionalExePaths": {
    "pwsh": "/usr/local/bin/pwsh",
  },
  "[bicep]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.insertFinalNewline": true,
    "editor.suggestSelection": "first",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggest.showWords": true,
    // "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on",
    },
  },
  "[bicep-params]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.insertFinalNewline": true,
    "editor.suggestSelection": "first",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggest.showWords": false,
    // "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on",
    },
  },
  ///////////////////////
  //     editor
  ///////////////////////
  "editor.tokenColorCustomizations": {
    "comments": "#ff9d00",
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 120,
  "editor.showFoldingControls": "always",
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "editor.parameterHints.enabled": false,
  "editor.fontSize": 12,
  "editor.lineHeight": 1.6,
  "editor.fontFamily": "Comic Code Ligatures",
  "editor.fontWeight": "normal",
  "editor.fontLigatures": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "boundary",
  "editor.minimap.enabled": false,
  "editor.minimap.showSlider": "always",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.guides.bracketPairs": true,
  // "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.largeFileOptimizations": false,
  "editor.guides.indentation": true,
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.wordWrap": "off",
  ///////////////////////
  //     files
  ///////////////////////
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 10000,
  "files.associations": {
    "**/.pipelines/**/*.yml": "azure-pipelines",
    "**/helm/**/*.yaml": "helm",
  },
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  ///////////////////////
  //     Window
  ///////////////////////
  "window.titleBarStyle": "custom",
  "workbench.sideBar.location": "right",
  "workbench.panel.showLabels": false,
  ///////////////////////
  //  Terminal
  ///////////////////////
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.fontFamily": "ComicMono NF",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  ///////////////////////
  // Debugger
  ///////////////////////
  "debug.openDebug": "openOnSessionStart",
  "debug.toolBarLocation": "docked",
  "debug.openExplorerOnEnd": true,
  ///////////////////////
  // GitHub Copilot Specific
  ///////////////////////
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "github.copilot.selectedCompletionModel": "claude",
  ///////////////////////
  //     Other
  ///////////////////////
